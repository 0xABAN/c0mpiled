{
  "name": "roster",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs migrate",
    "db:seed": "tsx --conditions=react-server --env-file=.env.local src/backend/db/seed.ts",
    "db:backfill-fake-files": "tsx --conditions=react-server --env-file=.env.local src/backend/db/backfill-fake-resume-files.ts",
    "redact": "tsx --conditions=react-server scripts/redact.ts",
    "demo:reset": "node --conditions=react-server --env-file=.env.local --import tsx src/backend/demo/reset.ts"
  },
  "dependencies": {
    "@aws-amplify/adapter-nextjs": "^1.8.0",
    "@aws-amplify/ui-react": "^6.15.7",
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/s3-request-presigner": "^3.1149.0",
    "aws-amplify": "^6.22.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.55.0",
    "mupdf": "^1.28.1",
    "next": "15.5.27",
    "pg": "^8.23.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1149.0",
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "15.5.27",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
